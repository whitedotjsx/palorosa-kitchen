# Copy this file to .env and fill the values. .env is gitignored.

# WordPress WooCommerce REST API credentials.
WORDPRESS_URL=
WOOCOMERCE_CONSUMER_KEY=
WOOCOMERCE_CONSUMER_SECRET=

# Path to the palorosa-breakfast-evaluation checkout. Canonical source of
# constants and catalog/overrides.json. Used by pnpm sync:source.
EVALUATION_REPO=

# Local team server (apps/kitchen-server).
KITCHEN_SERVER_PORT=5200
KITCHEN_SERVER_HOST=0.0.0.0
KITCHEN_EDITOR_URL=http://localhost:5199
# auto starts the catalog editor dev server when it is not running; off disables it.
KITCHEN_EDITOR_AUTOSTART=auto
# Chromium executable for the sheet PDF (/api/pdf). Empty auto-detects Playwright, Chrome or Edge.
KITCHEN_CHROMIUM_PATH=

# WhatsApp bot (apps/whatsapp-bot).
BOT_PORT=5210
# Shared secret for the /hook/order and /hook/orders endpoints. Empty disables the check.
BOT_HOOK_TOKEN=
KITCHEN_SERVER_URL=http://127.0.0.1:5200
# Comma separated phone numbers with country code. Only these receive notifications
# and only these can use the commands.
WHATSAPP_ALLOWLIST=
# Chromium executable for whatsapp-web.js. Empty auto-detects Playwright, Chrome or Edge.
WHATSAPP_CHROMIUM_PATH=
# Optional: pair with a phone number code instead of the QR. Digits with country code.
WHATSAPP_PAIRING_PHONE=
