# Copy this file to .env and fill the values. .env is gitignored.

# WordPress WooCommerce REST API credentials.
WORDPRESS_URL=
WOOCOMERCE_CONSUMER_KEY=
WOOCOMERCE_CONSUMER_SECRET=

# Path to the palorosa-breakfast-evaluation checkout. Canonical source of
# constants and catalog/overrides.json. Used by pnpm sync:source.
EVALUATION_REPO=

# Store order pull for the kitchen list (`pnpm orders <YYYY-MM-DD>`). HTTP only,
# no browser. The user needs permission to edit the WP All Export export; the
# password is the wp-login one, not an application password.
WP_ADMIN_URL=https://palorosabreakfast.com
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=
# WP All Export saved export id, the "Cron Job Key" (Settings) and the download
# token str(md5(cronKey + exportId)[0:16]). The token is derived if left empty.
WP_EXPORT_ID=1
WP_EXPORT_CRON_KEY=
WP_EXPORT_TOKEN=

# Catalog the desktop app resolves orders against and the panel edits. Empty uses ./data/seed.json.
KITCHEN_CATALOG_PATH=

# WhatsApp bot (apps/whatsapp-bot).
BOT_PORT=5210
# Shared secret for the /hook/order and /hook/orders endpoints. Empty disables the check.
BOT_HOOK_TOKEN=
# WooCommerce native webhook secret (POST /hook/woocommerce). Paste the same
# value in the webhook "Secret" in wp-admin; the bot checks X-WC-Webhook-Signature.
WC_WEBHOOK_SECRET=
# Comma separated phone numbers with country code. Only these receive notifications
# and only these can use the commands.
WHATSAPP_ALLOWLIST=
# Chromium executable for whatsapp-web.js. Empty auto-detects Playwright, Chrome or Edge.
WHATSAPP_CHROMIUM_PATH=
# Optional: pair with a phone number code instead of the QR. Digits with country code.
WHATSAPP_PAIRING_PHONE=

# Desktop app (apps/desktop). It bundles its own WhatsApp bot (whatsmeow, no
# browser) and reuses KITCHEN_SERVER_URL, WHATSAPP_ALLOWLIST,
# WHATSAPP_PAIRING_PHONE, BOT_PORT, BOT_HOOK_TOKEN and KITCHEN_CATALOG_PATH
# above. Session and bot state live in %APPDATA%\palorosa-kitchen.
# Set to off to run the window without the bot.
KITCHEN_WHATSAPP=
# Path to the built single-file list. Empty searches apps/standalone/dist/index.html.
KITCHEN_LIST_HTML=
# Path to the built single-file admin panel. Empty searches apps/panel/dist/index.html
# (build it with `pnpm build:panel`). Without it the panel server shows a placeholder.
KITCHEN_PANEL_HTML=
# 1 opens the WebView2 devtools and the whatsmeow debug log.
KITCHEN_DESKTOP_DEBUG=
# Local panel server port (loopback only). It serves the settings API and, when
# the bot runs, the hook routes on the same origin. Default 5211.
PANEL_PORT=
# Set to off to disable the automatic self-update from GitHub Releases (the
# tray item "Buscar actualización" and the panel button keep working).
KITCHEN_AUTO_UPDATE=

# Cloudflare named tunnel (apps/desktop). Empty TUNNEL_HOSTNAME disables it.
# Needs cloudflared logged in (`cloudflared tunnel login`) and the hostname zone
# in the account. The app creates the tunnel, routes the DNS and runs cloudflared
# as a sidecar the first time it starts. TUNNEL_SERVICE empty targets the local
# panel server, which also re-mounts the hook routes (one origin).
TUNNEL_HOSTNAME=
TUNNEL_NAME=palorosa-kitchen
TUNNEL_SERVICE=
CLOUDFLARED_PATH=
# Optional: run the tunnel with a token instead of `cloudflared tunnel login`.
# Get it on a PC already logged in with `cloudflared tunnel token <name>` (or
# create the tunnel in the Zero Trust dashboard) and paste it here or in
# Ajustes. The exported configuration carries it, so a new PC only imports it.
TUNNEL_TOKEN=
